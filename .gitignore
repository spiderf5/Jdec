# agent workspace state (session memory, not project code)
.workbuddy/
.workbuddy-ai/
tools/

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# jdec: downloaded engines and build artifacts, restorable via
#   python jdec.py engines                  (engine jars)
#   python src/tests/build_fixtures.py     (sample/mixin/flow/collide jars)
engines/*.jar
engines/ghidra/
engines/bridge/*.class
engines/tap/*.jar
engines/tap/*.class
engines/tap/classes/
engines/tests/
src/tests/build/
src/tests/*.jar

# jdec: transient run/debug outputs (decompiled trees, analysis dumps,
# downloaded MC jars/mappings under tests/mc)
src/tests/dbg*/
src/tests/mc/
src/tests/mcfull*/
src/tests/mcout/
src/tests/out*/
src/tests/demo_analysis/
src/tests/demo_flow/

# caches and mappings
cache/
.jdec_mappings/
pool_work/

# logs and crash dumps
*.log
logs/
src/logs/
hs_err_pid*.log

# CLI default output directories
*_decompiled/
*_analysis/
*_strings/
*_recovered/
*_natives/
*_pool/
scorecard.json
scorecard.md
out*/
*_auto/

# java compiled classes
*.class

# native 分析工件（样本转储与工作区，local-only；工具本身入库）
src/_ghproj_rt/
engines/frida/native/
engines/frida/config/
engines/frida/mappings*.tsv
engines/frida/_smoke_out.tsv
engines/frida/.mixin.out/

# 外部研究材料（含 DMCA 敏感源码），永不入库
study/
# resident JDK for class v69 (installed via tsinghua adoptium mirror)
jdk25/
# stub-jar cache fingerprints (rebuilt from STUB_SOURCES)
engines/*.sha256

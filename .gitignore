# agent workspace state (session memory, not project code)
.workbuddy/
.workbuddy-ai/
tools/

# python
__pycache__/
*.py[cod]
*.egg-info/
dist/

# jdec: downloaded engines and build artifacts, restorable via
#   python jdec.py engines                  (engine jars)
#   python jdec/tests/build_fixtures.py     (sample/mixin/flow/collide jars)
jdec/engines/*.jar
jdec/engines/ghidra/
jdec/engines/bridge/*.class
jdec/engines/tap/*.jar
jdec/engines/tap/*.class
jdec/engines/tap/classes/
jdec/engines/tests/
jdec/tests/build/
jdec/tests/*.jar

# jdec: transient run/debug outputs (decompiled trees, analysis dumps,
# downloaded MC jars/mappings under tests/mc)
jdec/tests/dbg*/
jdec/tests/mc/
jdec/tests/mcfull*/
jdec/tests/mcout/
jdec/tests/out*/
jdec/tests/demo_analysis/
jdec/tests/demo_flow/

# caches and mappings
cache/
.jdec_mappings/
pool_work/

# logs and crash dumps
*.log
logs/
jdec/logs/
hs_err_pid*.log

# CLI default output directories
*_decompiled/
*_analysis/
*_strings/
*_recovered/
*_natives/
*_pool/
scorecard.json
scorecard.md
out*/
*_auto/

# java compiled classes
*.class

# native 分析工件（样本转储与工作区，local-only；工具本身入库）
jdec/_ghproj_rt/
jdec/engines/frida/native/
jdec/engines/frida/config/
jdec/engines/frida/mappings*.tsv
jdec/engines/frida/_smoke_out.tsv
jdec/engines/frida/.mixin.out/

# 外部研究材料（含 DMCA 敏感源码），永不入库
study/
# resident JDK for class v69 (installed via tsinghua adoptium mirror)
jdk25/

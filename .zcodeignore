# agent workspace state (session memory, not project code)
.workbuddy/

# python
__pycache__/
*.py[cod]

# jdec: downloaded engines and build artifacts, restorable via
#   python jdec.py engines          (engine jars)
#   python tests/build_fixtures.py  (sample/mixin/flow/collide jars)
jdec/engines/*.jar
jdec/engines/ghidra/
jdec/engines/bridge/*.class
jdec/engines/tap/*.jar
jdec/engines/tap/*.class
jdec/engines/tap/classes/
jdec/engines/tests/
jdec/tests/build/
jdec/tests/*.jar

# jdec: transient run/debug outputs (decompiled trees, analysis dumps,
# downloaded MC jars/mappings under tests/mc)
jdec/tests/dbg*/
jdec/tests/mc/
jdec/tests/mcfull*/
jdec/tests/mcout/
jdec/tests/out*/
jdec/tests/demo_analysis/
jdec/tests/demo_flow/

# caches and mappings
cache/
.jdec_mappings/
pool_work/

# logs and crash dumps
*.log
logs/
jdec/logs/
hs_err_pid*.log

# CLI default output directories
*_decompiled/
*_analysis/
*_strings/
*_recovered/
*_natives/
*_pool/
scorecard.json
scorecard.md

# java compiled classes
*.class

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
